{
  "hosting": [
    {
      "target": "prod",
      "public": "dist/prod",
      "ignore": [
        "firebase.json",
        "**/.DS_Store",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        {
          "source": "/.well-known/assetlinks.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/nc",
          "destination": "/download?source=namecard&medium=offline&campaign=business_card",
          "type": 302
        },
        {
          "source": "/nc/",
          "destination": "/download?source=namecard&medium=offline&campaign=business_card",
          "type": 302
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    },
    {
      "target": "dev",
      "public": "dist/dev",
      "ignore": [
        "firebase.json",
        "**/.DS_Store",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "/.well-known/apple-app-site-association",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        {
          "source": "/.well-known/assetlinks.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json"
            }
          ]
        }
      ],
      "redirects": [
        {
          "source": "/nc",
          "destination": "/download?source=namecard&medium=offline&campaign=business_card",
          "type": 302
        },
        {
          "source": "/nc/",
          "destination": "/download?source=namecard&medium=offline&campaign=business_card",
          "type": 302
        }
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
